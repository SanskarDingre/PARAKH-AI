# MongoDB Atlas connection string
MONGO_URI=your_mongodb_atlas_connection_string_here

# Port the backend server runs on
PORT=5000

# Address of the Python OCR service (see ocr-service/)
OCR_SERVICE_URL=http://127.0.0.1:8000/extract-text

# Secret used to sign authentication tokens — use any long, random string
JWT_SECRET=replace_with_a_long_random_string

# Credentials for the initial admin account (used by scripts/seedAdmin.js)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=choose_a_strong_password

# Gmail account used to send OTP login codes (optional feature)
# Requires a Gmail "App Password", not your regular Gmail password
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_app_password
