# Copy this file to .env and fill in your values
# NEVER commit the real .env to git

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/legalmetrology?appName=Cluster0

# Express server port
PORT=5000

# Python OCR service URL (run ocr-service/main.py separately)
OCR_SERVICE_URL=http://127.0.0.1:8000/extract-text

# JWT secret — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Admin seed credentials (used by: npm run seed:admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123!

# Gmail SMTP for OTP emails (optional; OTP is logged to terminal if not set)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
